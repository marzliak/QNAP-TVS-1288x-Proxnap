# Optional InfluxDB 2.x writer. Keep credentials only in the installed file.
PROXNAP_INFLUX_URL=
PROXNAP_INFLUX_ORG=proxnap
PROXNAP_INFLUX_BUCKET=proxnap
PROXNAP_INFLUX_TOKEN=
PROXNAP_INFLUX_PRECISION=s
PROXNAP_METRICS_INTERVAL_FAST=10
PROXNAP_METRICS_INTERVAL_MEDIUM=30
PROXNAP_METRICS_INTERVAL_QNAP=120
PROXNAP_METRICS_INTERVAL_SLOW=300
PROXNAP_METRICS_TIMEOUT=8
# Optional JSON object of local serial -> slot labels. No machine map is shipped.
PROXNAP_METRICS_SLOT_MAP={}
# Namespace only: [A-Za-z][A-Za-z0-9_]*; final measurement is <prefix>_<suffix>.
# Applies identically to dry-run and HTTP output; the default preserves proxnap_*.
PROXNAP_METRICS_MEASUREMENT_PREFIX=proxnap
# Ordered CSV of literal units; bare names or explicit unit suffixes are retained.
# Disabled/inactive units remain series with enabled=0 / active=0, not filtered out.
PROXNAP_METRICS_SERVICES=proxnap-lcd,proxnap-fan-control,proxnap-status-led,proxnap-panel-breath,proxnap-copy-button,proxnap-power-button,qnap8528-load-module,pveproxy,pvedaemon,pvestatd,zfs-zed,smartd
