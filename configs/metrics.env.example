# Optional InfluxDB 2.x writer. Keep credentials only in the installed file.
PROXNAP_INFLUX_URL=
PROXNAP_INFLUX_ORG=proxnap
PROXNAP_INFLUX_BUCKET=proxnap
PROXNAP_INFLUX_TOKEN=
PROXNAP_INFLUX_PRECISION=s
PROXNAP_METRICS_INTERVAL_FAST=10
PROXNAP_METRICS_INTERVAL_MEDIUM=30
PROXNAP_METRICS_INTERVAL_QNAP=120
PROXNAP_METRICS_INTERVAL_SLOW=300
PROXNAP_METRICS_TIMEOUT=8
# Optional JSON object of local serial -> slot labels. No machine map is shipped.
PROXNAP_METRICS_SLOT_MAP={}
