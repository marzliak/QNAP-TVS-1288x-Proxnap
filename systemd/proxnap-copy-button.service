[Unit]
Description=Proxnap TVS-1288X guarded USB Copy button
After=qnap8528-load-module.service
Wants=qnap8528-load-module.service

[Service]
Type=simple
Environment=PYTHONPATH=/opt/proxnap
ExecStart=/usr/bin/python3 -m proxnap.buttons --kind copy --config /etc/proxnap/copy-button.conf
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true

[Install]
WantedBy=multi-user.target
