[Unit]
Description=Proxnap TVS-1288X disk activity and SMART LEDs
Requires=qnap8528-load-module.service
After=qnap8528-load-module.service

[Service]
Type=simple
Environment=PYTHONPATH=/opt/proxnap
ExecStart=/usr/bin/python3 -m proxnap.disk_leds --config /etc/proxnap/disk-leds.conf
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true

[Install]
WantedBy=multi-user.target
